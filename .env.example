# JurisPrism Environment Configuration

# Server & Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security (Required)
JWT_SECRET=super-secret-jwt-signing-key-for-jurisprism-change-in-production
SESSION_MAX_AGE_SECONDS=604800

# AI Provider Configuration
# Supported providers: "auto" (default: uses Gemini if key exists, else deterministic local engine), "gemini", "deterministic"
AI_PROVIDER=auto

# Google Gemini API Key (Optional: when left blank, the high-fidelity offline legal engine operates seamlessly)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage & Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_DIR=./data/uploads
DB_PATH=./data/jurisprism.db
